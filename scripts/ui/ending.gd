extends Node3D
## Wordless ending: both ships glide toward the horizon, the sun rises, collected orbs float up and the
## sky warms. Then an icon + text credits card, then the title. Any press after 3 s skips ahead.

const DUR := 16.0

var _sky: ProceduralSkyMaterial
var _sun: MeshInstance3D
var _ships: Array[Node3D] = []
var _orbs: Array[Node3D] = []
var _t := 0.0
var _credits: Label
var _done := false


func _ready() -> void:
	var env := Environment.new()
	var sky := Sky.new()
	_sky = ProceduralSkyMaterial.new()
	sky.sky_material = _sky
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)
	var cam := Camera3D.new()
	cam.position = Vector3(0, 4, 18)
	cam.fov = 55
	add_child(cam)
	_sun = MeshInstance3D.new()
	var sm := SphereMesh.new()
	sm.radius = 30
	sm.height = 60
	_sun.mesh = sm
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = Color("#ffe9a8")
	_sun.material_override = mat
	_sun.position = Vector3(0, -60, -400)
	add_child(_sun)
	for i in 2:
		var n: Node3D = (load("res://assets/ships/ship_%s_c%d.glb" % [["air_kite", "hover_sled"][i], int(Save.data["colour"])]) as PackedScene).instantiate()
		Game.paint(n)
		n.position = Vector3(-3.5 + i * 7.0, 0, 0)
		add_child(n)
		_ships.append(n)
	var orb: PackedScene = load("res://assets/fx/pickup_orb.glb")
	var count := 0
	for i in range(1, 7):
		count += int(Save.level(i)["orbs"])
	for i in clampi(count / 4, 6, 40):
		var o: Node3D = orb.instantiate()
		Game.paint(o, true)
		o.position = Vector3(randf_range(-14, 14), randf_range(-10, -4), randf_range(-20, 4))
		add_child(o)
		_orbs.append(o)
	var cl := CanvasLayer.new()
	add_child(cl)
	_credits = Label.new()
	_credits.text = "rail-shooter\n\n♥\n\nMade with Godot Engine\nAll art, sound and music generated by this project"
	_credits.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_credits.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_credits.set_anchors_preset(Control.PRESET_FULL_RECT)
	_credits.add_theme_color_override("font_color", Color("#5a4a78"))
	_credits.modulate.a = 0.0
	cl.add_child(_credits)
	AudioBus.music("music_ending")


func _process(dt: float) -> void:
	_t += dt
	var k := clampf(_t / (DUR * 0.7), 0.0, 1.0)
	_sky.sky_top_color = Color("#4b4a7a").lerp(Color("#8ec9f0"), k)
	_sky.sky_horizon_color = Color("#f6a98f").lerp(Color("#fff1d6"), k)
	_sky.ground_horizon_color = _sky.sky_horizon_color
	_sky.ground_bottom_color = Color("#d9c3d6")
	_sun.position.y = lerpf(-60.0, 40.0, ease(k, 0.6))
	for i in _ships.size():
		var n := _ships[i]
		n.position.z = -_t * 1.2
		n.position.y = sin(Game.t * PI + i) * 0.4 + _t * 0.15
	for o in _orbs:
		o.position.y += dt * 1.5
		o.rotation.y += dt
	_credits.modulate.a = clampf((_t - DUR * 0.75) / 2.0, 0.0, 1.0)
	var skip := _t > 3.0 and (Input.is_action_just_pressed("menu_accept") or Input.is_action_just_pressed("fire"))
	if not _done and (_t > DUR + 4.0 or skip):
		_done = true
		Game.go(Game.TITLE)
